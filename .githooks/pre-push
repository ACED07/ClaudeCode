#!/bin/sh
# Refuse to push a commit in which a CLAUDE.md / AGENTS.md pair differs or is incomplete.
# The pre-commit hook keeps them in sync; this catches commits made without it.

status=0

while read -r local_ref local_sha remote_ref remote_sha; do
    # All-zero sha means the branch is being deleted; nothing to check.
    case $local_sha in *[!0]*) ;; *) continue ;; esac

    dirs=$(git ls-tree -r --name-only "$local_sha" | grep -E '(^|/)(CLAUDE|AGENTS)\.md$' \
        | sed -E 's#(^|/)(CLAUDE|AGENTS)\.md$##' | sort -u)
    [ -z "$dirs" ] && continue

    while IFS= read -r d; do
        if [ -n "$d" ]; then c="$d/CLAUDE.md"; a="$d/AGENTS.md"; else c="CLAUDE.md"; a="AGENTS.md"; fi
        c_blob=$(git rev-parse -q --verify "$local_sha:$c" 2>/dev/null)
        a_blob=$(git rev-parse -q --verify "$local_sha:$a" 2>/dev/null)

        if [ -z "$c_blob" ] || [ -z "$a_blob" ]; then
            echo "pre-push: $local_ref has only one of $c / $a. Add the other (an identical copy)." >&2
            status=1
        elif [ "$c_blob" != "$a_blob" ]; then
            echo "pre-push: $c and $a differ in $local_ref. Make them identical and commit before pushing." >&2
            status=1
        fi
    done <<EOF
$dirs
EOF
done

exit $status
